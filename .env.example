# ============================================================
# REYCE — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# Stripe — récupérer sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret — récupérer sur https://dashboard.stripe.com/webhooks
# En développement avec Stripe CLI : stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# URL de base du site (sans slash final)
# En développement : http://localhost:3000
# En production    : https://reyce.fr
BASE_URL=http://localhost:3000

# Port du serveur (défaut : 3000)
PORT=3000

# Base de données PostgreSQL (Railway — plugin Postgres du même projet)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Token d'accès admin (/admin.html) — chaîne longue et aléatoire
ADMIN_TOKEN=change-me

# Email — envoi via API Gmail (OAuth2), pas de SMTP (bloqué par Railway)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=contact@reyce.fr
OWNER_EMAIL=contact@reyce.fr

# Google Calendar — même credentials OAuth2 que Gmail, refresh token dédié au calendrier
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# SMS (Twilio) — optionnel, désactivé si absent
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
